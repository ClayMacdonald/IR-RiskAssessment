{
  "name": "irp-regsp-assessment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-clients.mjs && node scripts/sync-login.mjs && vite build",
    "preview": "vite preview",
    "pages": "wrangler pages dev dist --port 8799",
    "sync:login": "node scripts/sync-login.mjs",
    "extract:irp": "node scripts/extract-irp.mjs",
    "add-client": "node scripts/add-client.mjs",
    "review:export": "node scripts/review-export.mjs",
    "test:unit": "node scripts/build-clients.mjs && node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "core-js": false
  }
}
