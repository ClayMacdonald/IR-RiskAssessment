{
  "name": "irp-regsp-assessment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently --names api,vite --prefix-colors magenta,cyan --kill-others-on-fail \"npm:dev:api\" \"node scripts/wait-for-api.mjs && npm run dev:vite\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:vite": "node scripts/sync-login.mjs && vite",
    "dev:setup": "node scripts/dev-setup.mjs",
    "build": "node scripts/build-clients.mjs && node scripts/sync-login.mjs && vite build && vite build --config vite.admin.config.js",
    "preview": "vite preview",
    "pages": "node scripts/dev-api.mjs dist",
    "sync:login": "node scripts/sync-login.mjs",
    "extract:irp": "node scripts/extract-irp.mjs",
    "add-client": "node scripts/add-client.mjs",
    "import-codes": "node scripts/import-codes.mjs",
    "review:export": "node scripts/review-export.mjs",
    "test:unit": "node scripts/build-clients.mjs && node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "concurrently": "10.0.6",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "core-js": false
  }
}
