# Local secrets for "npm run pages" (wrangler pages dev). Copy to .dev.vars, which is git-ignored.
# Test values only. Never put production secrets here.
SESSION_SECRET=local-dev-session-secret-not-for-production-use-0123456789
# Access code for local use and the smoke test: smoke-test-code-2026-xyzw
ACCESS_CODES={"2e21573c4b3012ce3007ee1a0419d723336132d4d72116f307e9ac784bb94c66":{"clientId":"smoke-test","firmName":"Smoke Test Advisors","expires":"2099-12-31"}}
# Cloudflare's public test site key. The login page loads Turnstile with it.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Skips server-side Turnstile verification, and only for requests to localhost or 127.0.0.1.
DEV_SKIP_TURNSTILE=1
ALLOWED_ORIGINS=http://localhost:8799,http://127.0.0.1:8799
