# Local secrets for the Pages Functions (npm run dev, npm run pages).
# Run "npm run dev:setup" once: it copies this file to .dev.vars (git-ignored), generates
# SESSION_SECRET, sets up the local D1 database and prints your local access code.
# Test values only. Never put production secrets here, and never set LOCAL_DEV in Cloudflare.

# Local dev mode. Skips Turnstile verification and drops Secure from the session cookie so it works
# over http://localhost. Ignored unless every ALLOWED_ORIGINS entry is http localhost or 127.0.0.1.
LOCAL_DEV=1

# Signs session cookies. dev:setup replaces the placeholder with 48 random bytes.
SESSION_SECRET=replace-me

# Cloudflare's public Turnstile test keys (always pass). The login page loads the widget with the site key.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Completion notices. With this dummy key the Function saves the record, logs "stored_dry_run" and never calls Resend.
RESEND_API_KEY=re_local_dev_dummy
RESEND_FROM_EMAIL=IRP Local <local@example.com>
COMPLETION_NOTIFY_EMAIL=local@example.com

# Origins allowed to post to the Functions. dev:setup sets this from scripts/dev-ports.mjs.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8799,http://localhost:8799

# Admin dashboard. In production, Cloudflare Access signs admins in and the Functions verify its JWT
# (ACCESS_TEAM_DOMAIN, ACCESS_AUD). Locally, with LOCAL_DEV=1, ADMIN_DEV_EMAIL stands in for the JWT.
# It must end with @ADMIN_EMAIL_DOMAIN. Ignored outside local dev mode.
ADMIN_EMAIL_DOMAIN=advisordefense.com
ADMIN_DEV_EMAIL=dev@advisordefense.com
